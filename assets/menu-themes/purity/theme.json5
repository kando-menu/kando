{
  name: 'Purity',
  author: 'Luctarie',
  license: 'CC0-1.0',
  themeVersion: '1.1',
  description: 'Radial menu with a sleek look, with hotkey display compatibility and colored wedges.',

  engineVersion: 1,

  maxMenuRadius: 180,
  centerTextWrapWidth: 140,  // Precisely matches inner circle diameter (70px radius × 2)
  drawChildrenBelow: true,
  childTransitionTime: 200,

  // Required by Kando to activate wedge and separator rendering
  drawWedgeSeparators: true,
  drawSelectionWedges: true,
  
  
  colors: {
    // === Text Color Configuration ===
    'text-color': 'rgb(255 255 255 / 0.9)',             // Center text primary color

    // === Icon & Indicator Color Configuration ===
    'icon-color': 'rgb(255 255 255 / 0.9)',             // Icon and Parent arrow color
    'icon-hover-color': 'rgb(255 255 255 / 1.0)',       // Icon color on hover

    // === Ring Color Configuration ===
    'ring-color': 'rgb(13 13 13 / 0.86)',               // Ring main body color - dark gray
    'inner-circle': 'rgba(255, 255, 255, 0.4)',         // Thinner inner circle ring color

    // === Wedge and Sector Configuration ===
    'wedge-color': 'rgb(132 0 255 / 0.50)',             // Wedge background highlight on hover
    'sector-color-submenu': 'rgb(103 0 237 / 0.82)',             // Sector submenu highlight on hover
    'sector-color-action': 'rgb(198 118 255 / 0.82)',             // Sector action highlight on hover

    // === Background Configuration ===
    'background-main': 'rgb(0 0 0 / 0)',                // Main full-screen background
    'background-secondary': 'rgb(0 0 0 / 0.85)'         // Vignette color on corners and edges
  },
  
  
  layers: [
    {
      class: 'quick-key',
      content: 'quick-select-key'
    },
    {
      class: 'icon-layer',
      content: 'icon'
    }
  ]
}
